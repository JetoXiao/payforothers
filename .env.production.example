# Copy this file to .env. Never commit the real .env file.
APP_PORT=8080
TZ=Asia/Shanghai

# Generate each value independently, for example: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-random-64-hex-value
JWT_SECRET=replace-with-another-random-64-hex-value
USER_JWT_SECRET=replace-with-a-third-random-64-hex-value

# Used only for the first bootstrap. Change the password after first login.
BOOTSTRAP_DEFAULT_ADMIN_USERNAME=operator
BOOTSTRAP_DEFAULT_ADMIN_PASSWORD=replace-with-a-long-unique-password
WEB_ADMIN_PATH=/ops-console-change-me

# Use exact HTTPS origins; do not use "*" with credentialed requests.
CORS_ALLOWED_ORIGINS=["https://shop.example.com"]

EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Pay For Others
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
